# Copy to .env and adjust. .env is git-ignored — never commit real credentials.
# Target application (staging/test environment only)
BASE_URL=http://localhost:4000

# Test account used by the explorer (explore.config.json) and by playwright/tests/auth.setup.ts
QA_USERNAME=admin
QA_PASSWORD=Admin@123

# Set to 0 when BASE_URL points to a real app, so Playwright does not start the bundled demo app
START_DEMO_APP=1

# Demo app only: 2 simulates a new UI release (renamed labels) for the maintenance demo
DEMO_UI_VERSION=1

# Parallel workers (default: Playwright decides). Retries on failure (default 0).
# WORKERS=4
# RETRIES=0
